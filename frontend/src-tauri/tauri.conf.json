{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "neurograph",
  "version": "0.1.0",
  "identifier": "com.neurograph.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NeuroGraph",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Juan Boza (\"Proxy\") — Instituto Dédalus",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/postgres/**/*",
      "resources/migrations/**/*",
      "resources/neurograph_snapshot.sql",
      "resources/backend/**/*"
    ],
    "windows": {
      "certificateThumbprint": "39E4C066B6C3BAC96061F15D71C64F7ABA42436A",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
